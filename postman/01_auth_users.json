          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.data && data.data.length) { const u = data.data.find(x => x.email === 'test.student@university.edu'); if (u) pm.collectionVariables.set('userId', u.id); }"
                ]
              }
            }
