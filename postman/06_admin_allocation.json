        {
          "name": "List the requests of the date",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/reservations?date=2027-12-15",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "reservations"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2027-12-15"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
