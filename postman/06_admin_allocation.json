          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('two rows with purpose, groupSize and reason', () => { pm.expect(data.data.length).to.be.at.least(2); pm.expect(data.data[0]).to.have.property('purpose'); pm.expect(data.data[0]).to.have.property('groupSize'); pm.expect(data.data[0]).to.have.property('reason'); });"
                ]
              }
            }
          ]
